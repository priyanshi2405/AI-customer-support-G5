# Copy this file to .env and fill in your values.

PORT=3000

# PostgreSQL connection string (create the database first, see README)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_assistant

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Optional. Leave empty to run in keyword mode (no internet or paid API needed).
# With a key, documents are embedded and answers are written by an LLM.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
SIMILARITY_THRESHOLD=0.3
